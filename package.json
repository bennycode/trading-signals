{
  "name": "typedtrader",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "clean": "lerna run clean --parallel",
    "dist": "lerna run dist",
    "fix": "npm run fix:code && npm run fix:other",
    "fix:code": "oxlint --fix || true",
    "fix:other": "oxfmt",
    "graph": "nx graph",
    "prelint": "lerna run dist",
    "lint": "npm run lint:code && npm run lint:other",
    "lint:code": "oxlint",
    "lint:other": "oxfmt --list-different",
    "release": "gh workflow run release.yml",
    "start:bot": "lerna run dist --scope @typedtrader/messaging --include-dependencies && lerna run start --scope @typedtrader/messaging",
    "start:docs": "lerna run dist --scope trading-signals-docs --include-dependencies && lerna run dev --scope trading-signals-docs",
    "pretest": "lerna run dist",
    "test": "npm run test:imports && lerna run --no-sort --concurrency 8 test",
    "test:imports": "knip",
    "test:types": "lerna run --no-sort --concurrency 8 test:types",
    "version": "oxfmt packages/*/CHANGELOG.md"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.0.18",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "github-actionlint": "^1.7.12",
    "jsdom": "^30.0.0",
    "knip": "^6.29.0",
    "lefthook": "^2.1.9",
    "lerna": "^9.0.7",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vitest": "^4.0.14"
  },
  "optionalDependencies": {
    "encoding": "^0.1.13"
  },
  "overrides": {
    "axios": ">=1.14.0",
    "brace-expansion": ">=5.0.8",
    "esbuild": ">=0.25.0",
    "js-yaml": ">=4.3.0",
    "postcss": ">=8.5.10",
    "sharp": ">=0.35.1",
    "tar": ">=7.5.21"
  }
}
