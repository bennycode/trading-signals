{
  "name": "typedtrader",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "clean": "lerna run clean --parallel",
    "dist": "lerna run dist",
    "fix": "npm run fix:code && npm run fix:other",
    "fix:code": "oxlint --fix || true",
    "fix:other": "oxfmt",
    "graph": "nx graph",
    "prelint": "lerna run dist",
    "lint": "npm run lint:code && npm run lint:other",
    "lint:code": "oxlint",
    "lint:other": "oxfmt --list-different",
    "release": "gh workflow run release.yml",
    "start:bot": "lerna run dist --scope @typedtrader/messaging --include-dependencies && lerna run start --scope @typedtrader/messaging",
    "start:docs": "lerna run dist --scope trading-signals-docs --include-dependencies && lerna run dev --scope trading-signals-docs",
    "pretest": "lerna run dist",
    "test": "npm run test:imports && lerna run --no-sort --concurrency 8 test",
    "test:imports": "knip",
    "test:types": "lerna run --no-sort --concurrency 8 test:types",
    "version": "oxfmt packages/*/CHANGELOG.md"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^4.0.18",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "lerna": "^10.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.14"
  },
  "optionalDependencies": {
    "encoding": "^0.1.13"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    },
    "lerna": {
      "js-yaml": "^5.4.2",
      "pacote": "^21.5.1"
    },
    "nx": {
      "smol-toml": "^1.7.1"
    },
    "remark-mdx-frontmatter": {
      "toml": "^5.0.0"
    }
  }
}
