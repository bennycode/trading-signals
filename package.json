{
  "name": "typedtrader",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "clean": "lerna run clean --parallel",
    "dist": "lerna run dist",
    "fix": "npm run fix:code && npm run fix:other",
    "fix:code": "oxlint --fix || true",
    "fix:other": "oxfmt",
    "graph": "nx graph",
    "prelint": "lerna run dist",
    "lint": "npm run lint:code && npm run lint:complexity && npm run lint:other",
    "lint:code": "oxlint",
    "lint:complexity": "fta packages --config-path fta.json",
    "lint:other": "oxfmt --list-different",
    "release": "gh workflow run release.yml",
    "start:bot": "lerna run dist --scope @typedtrader/messaging --include-dependencies && lerna run start --scope @typedtrader/messaging",
    "start:bot:op": "op run --env-file=.env.op -- npm run start:bot",
    "start:docs": "lerna run dist --scope trading-signals-docs --include-dependencies && lerna run dev --scope trading-signals-docs",
    "pretest": "lerna run dist",
    "test": "npm run test:imports && tsc -p tsconfig.json && lerna run --no-sort --concurrency 8 test",
    "test:imports": "knip",
    "test:types": "tsc -p tsconfig.json && lerna run --no-sort --concurrency 8 test:types",
    "version": "oxfmt packages/*/CHANGELOG.md"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "esbuild": "^0.28.2",
    "fta-cli": "^3.1.0",
    "jsdom": "^31.0.0",
    "knip": "^6.37.0",
    "lefthook": "^2.2.2",
    "lerna": "^10.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "encoding": "^0.1.14"
  },
  "overrides": {
    "@chevrotain/cst-dts-gen": {
      "lodash-es": "^4.18.1"
    },
    "@chevrotain/gast": {
      "lodash-es": "^4.18.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    },
    "chevrotain": {
      "lodash-es": "^4.18.1"
    },
    "glob": "^14.0.2",
    "katex": "^0.18.2",
    "lerna": {
      "js-yaml": "^5.4.2",
      "pacote": "^21.5.1"
    },
    "minimatch": "^11.0.1",
    "nx": {
      "axios": "^1.20.0",
      "brace-expansion": "^5.0.12",
      "smol-toml": "^1.7.1",
      "undici": "^7.30.1"
    },
    "qs": "^6.17.1",
    "toml": "^5.0.1"
  }
}
