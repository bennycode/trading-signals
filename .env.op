# Every variable the packages read, for the 1Password CLI. The file holds no secrets: `op run`
# resolves each `op://` reference from the "trading-signals" vault, passes plain values through
# unchanged, and hands everything to the command as environment variables.
#
#   op run --env-file=.env.op -- npm run start:bot
#
# Without 1Password, put the same variables with real values into a gitignored `.env` next to this
# file; every npm script loads it when it exists.

# --- Brokers (@typedtrader/exchange) ---

# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_PAPER_API_KEY=op://trading-signals/ALPACA_PAPER_API_KEY/credential
ALPACA_PAPER_API_SECRET=op://trading-signals/ALPACA_PAPER_API_SECRET/credential

# https://app.alpaca.markets/brokerage/dashboard/overview
ALPACA_LIVE_API_KEY=op://trading-signals/ALPACA_LIVE_API_KEY/credential
ALPACA_LIVE_API_SECRET=op://trading-signals/ALPACA_LIVE_API_SECRET/credential

# Trading212 trades the practice account unless this is "false".
TRADING212_USE_PAPER=true

# Trading212 App → Switch to Practice → Settings API → Generate API key
TRADING212_PAPER_API_KEY=op://trading-signals/TRADING212_PAPER_API_KEY/credential
TRADING212_PAPER_API_SECRET=op://trading-signals/TRADING212_PAPER_API_SECRET/credential

# Trading212 App → Settings → API → Generate API key
# TRADING212_LIVE_API_KEY=op://trading-signals/TRADING212_LIVE_API_KEY/credential
# TRADING212_LIVE_API_SECRET=op://trading-signals/TRADING212_LIVE_API_SECRET/credential

# --- Market data ---

ALPHAVANTAGE_API_KEY=op://trading-signals/ALPHAVANTAGE_API_KEY/credential
FMP_API_KEY=op://trading-signals/FMP_API_KEY/credential
MASSIVE_API_KEY=op://trading-signals/MASSIVE_API_KEY/credential
TIPRANKS_API_KEY=op://trading-signals/TIPRANKS_API_KEY/credential
TWELVEDATA_API_KEY=op://trading-signals/TWELVEDATA_API_KEY/credential

# --- Bot (@typedtrader/messaging) ---

TYPEDTRADER_DB_DIRECTORY=.database
TYPEDTRADER_DB_ENCRYPTION_KEY=op://trading-signals/TYPEDTRADER_DB_ENCRYPTION_KEY/credential

TELEGRAM_BOT_TOKEN=op://trading-signals/TELEGRAM_BOT_TOKEN/credential
# Comma-separated Telegram user IDs allowed to use the bot. Empty means anyone can.
TELEGRAM_OWNER_IDS=
