# Defaults for every package. Put real values in a `.env` next to this file; it is gitignored and
# overrides these, and variables already set in the environment override both.

# --- Brokers (@typedtrader/exchange) ---

ALPACA_USE_PAPER=true

# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_PAPER_API_KEY=secret
ALPACA_PAPER_API_SECRET=secret

# https://app.alpaca.markets/brokerage/dashboard/overview
ALPACA_LIVE_API_KEY=secret
ALPACA_LIVE_API_SECRET=secret

TRADING212_USE_PAPER=true

# Trading212 App → Switch to Practice → Settings API → Generate API key
TRADING212_PAPER_API_KEY=secret
TRADING212_PAPER_API_SECRET=secret

# Trading212 App → Settings → API → Generate API key
TRADING212_LIVE_API_KEY=secret
TRADING212_LIVE_API_SECRET=secret

# --- Bot (@typedtrader/messaging) ---

# TypedTrader Setup
TYPEDTRADER_DB_DIRECTORY=.database
TYPEDTRADER_DB_ENCRYPTION_KEY=

# Alpaca MCP
# https://github.com/alpacahq/alpaca-mcp-server
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=True

# Telegram Messaging
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_IDS=
