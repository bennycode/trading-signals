{
  "bugs": {
    "url": "https://github.com/bennycode/trading-signals/issues"
  },
  "dependencies": {
    "@typedtrader/exchange": "0.3.0",
    "@types/big.js": "^7.0.0",
    "big.js": "^7.0.1",
    "ms": "4.0.0-nightly.202508271359",
    "trading-signals": "8.0.0",
    "zod": "^4.4.3"
  },
  "description": "Trading strategies to run trading bots with JavaScript / TypeScript.",
  "devDependencies": {
    "tsx": "^4.22.5"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "!dist/start",
    "!dist/test",
    "!dist/**/*.test.*"
  ],
  "homepage": "https://bennycode.com/trading-signals",
  "keywords": [
    "trading"
  ],
  "license": "MIT",
  "name": "trading-strategies",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf coverage dist",
    "dist": "npm run clean && npm run build",
    "backtest": "tsx src/start/runBacktest.ts",
    "strategy": "tsx src/start/runStrategy.ts",
    "fix": "npm run fix:code && npm run fix:other",
    "fix:code": "oxlint . --fix || true",
    "fix:other": "oxfmt",
    "lint": "npm run test:types && npm run lint:code && npm run lint:other",
    "lint:code": "oxlint .",
    "lint:other": "oxfmt --list-different",
    "dev": "npm run test:types && tsx watch src/start.ts",
    "start": "tsx src/start.ts",
    "test": "npm run test:types && npm run test:units",
    "test:types": "tsc --noEmit",
    "test:units": "vitest run --passWithNoTests",
    "test:units:watch": "vitest --watch"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "0.4.0"
}
