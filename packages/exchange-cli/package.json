{
  "name": "@typedtrader/exchange-cli",
  "version": "0.0.0",
  "description": "Command-line interface for the typed broker clients of @typedtrader/exchange.",
  "keywords": [
    "cli",
    "trading",
    "typedtrader"
  ],
  "homepage": "https://bennycode.com/trading-signals",
  "bugs": {
    "url": "https://github.com/bennycode/trading-signals/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennycode/trading-signals.git",
    "directory": "packages/exchange-cli"
  },
  "bin": {
    "exchange-cli": "./dist/exchange-cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cli": "tsx src/exchange-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node --eval \"require('node:fs').chmodSync('dist/exchange-cli.js', 0o755)\"",
    "clean": "rimraf coverage dist",
    "dist": "npm run clean && npm run build",
    "fix": "npm run fix:code && npm run fix:other",
    "fix:code": "oxlint . --fix || true",
    "fix:other": "oxfmt",
    "lint": "npm run lint:code && npm run lint:other",
    "lint:code": "oxlint .",
    "lint:other": "oxfmt --list-different",
    "test": "npm run test:types && npm run test:units",
    "test:types": "tsc --noEmit",
    "test:units": "vitest run",
    "test:units:watch": "vitest --watch"
  },
  "dependencies": {
    "@typedtrader/exchange": "0.3.3",
    "@types/big.js": "^7.0.0",
    "big.js": "^7.0.1",
    "commander": "^14.0.3",
    "ms": "4.0.0-nightly.202508271359"
  }
}
