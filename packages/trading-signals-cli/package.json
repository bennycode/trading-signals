{
  "name": "trading-signals-cli",
  "version": "0.0.0",
  "description": "Command-line interface for the technical indicators of trading-signals.",
  "keywords": [
    "cli",
    "indicator",
    "technical-analysis",
    "technical-indicators",
    "trading"
  ],
  "homepage": "https://bennycode.com/trading-signals",
  "bugs": {
    "url": "https://github.com/bennycode/trading-signals/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennycode/trading-signals.git",
    "directory": "packages/trading-signals-cli"
  },
  "bin": {
    "trading-signals-cli": "./dist/trading-signals-cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cli": "tsx src/trading-signals-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf coverage dist",
    "dist": "npm run clean && npm run build",
    "fix": "npm run fix:code && npm run fix:other",
    "fix:code": "oxlint . --fix || true",
    "fix:other": "oxfmt",
    "lint": "npm run lint:code && npm run lint:other",
    "lint:code": "oxlint .",
    "lint:other": "oxfmt --list-different",
    "test": "npm run test:types && npm run test:units",
    "test:types": "tsc --noEmit",
    "test:units": "vitest run",
    "test:units:watch": "vitest --watch"
  },
  "dependencies": {
    "trading-signals": "8.3.0"
  }
}
