{
  "name": "trading-signals-docs",
  "version": "2.0.0",
  "private": true,
  "description": "Documentation and showcase website for trading-signals library",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dist": "npm run build",
    "start": "next start",
    "test": "npm run test:types && npm run test:units",
    "test:e2e": "playwright test",
    "test:types": "tsc --noEmit",
    "test:units": "vitest run",
    "test:watch": "vitest",
    "fix": "npm run fix:code && npm run fix:other",
    "fix:code": "oxlint . --fix || true",
    "fix:other": "oxfmt",
    "lint": "npm run lint:code && npm run lint:other",
    "lint:code": "oxlint .",
    "lint:other": "oxfmt --list-different"
  },
  "dependencies": {
    "@highcharts/react": "^5.2.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@typedtrader/candles": "0.2.0",
    "@typedtrader/exchange": "0.3.0",
    "@types/big.js": "^7.0.0",
    "big.js": "^7.0.1",
    "highcharts": "^13.0.0",
    "next": "^16.3.0-preview.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "trading-signals": "8.0.0",
    "trading-strategies": "0.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.2"
  }
}
