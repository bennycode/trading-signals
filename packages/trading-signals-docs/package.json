{
  "name": "trading-signals-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for trading-signals with interactive demos and in-browser backtesting, built with Vocs",
  "type": "module",
  "scripts": {
    "prebuild": "npm run generate",
    "dev": "tsx scripts/site.ts dev",
    "build": "tsx scripts/site.ts build",
    "dist": "npm run build",
    "generate": "tsx --tsconfig scripts/tsconfig.json scripts/generate-indicator-pages.ts && oxfmt src/pages/indicators src/sidebar.generated.ts",
    "preview": "vocs preview",
    "test": "npm run test:types",
    "test:types": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@highcharts/react": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@typedtrader/candles": "0.2.3",
    "@typedtrader/exchange": "0.3.3",
    "@types/big.js": "^7.0.0",
    "big.js": "^7.0.1",
    "events": "^3.3.0",
    "highcharts": "^13.1.1",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.2",
    "trading-signals": "8.3.0",
    "trading-strategies": "0.4.5",
    "vite": "^8.3.0",
    "vocs": "^2.10.0",
    "waku": "1.0.0-beta.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
