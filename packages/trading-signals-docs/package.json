{
  "name": "trading-signals-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for trading-signals with interactive demos and in-browser backtesting, built with Vocs",
  "type": "module",
  "scripts": {
    "prebuild": "npm run generate",
    "dev": "tsx scripts/site.ts dev",
    "build": "tsx scripts/site.ts build",
    "dist": "npm run build",
    "generate": "tsx --tsconfig scripts/tsconfig.json scripts/generate-indicator-pages.ts && oxfmt src/pages/indicators src/sidebar.generated.ts",
    "preview": "vocs preview",
    "test": "npm run test:types",
    "test:types": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@highcharts/react": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@typedtrader/candles": "0.2.4",
    "@typedtrader/exchange": "0.4.0",
    "@types/big.js": "^7.0.0",
    "big.js": "^7.0.1",
    "events": "^3.3.0",
    "highcharts": "^13.1.1",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "trading-signals": "8.4.0",
    "trading-strategies": "0.5.0",
    "vite": "^8.3.7",
    "vocs": "^2.12.0",
    "waku": "1.0.0-rc.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
