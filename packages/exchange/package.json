{
  "name": "@typedtrader/exchange",
  "version": "0.5.0",
  "description": "Trading strategies to run trading bots with JavaScript / TypeScript.",
  "keywords": [
    "trading",
    "typedtrader"
  ],
  "homepage": "https://bennycode.com/trading-signals",
  "bugs": {
    "url": "https://github.com/bennycode/trading-signals/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennycode/trading-signals.git",
    "directory": "packages/exchange"
  },
  "files": [
    "dist",
    "!dist/start",
    "!dist/test",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "alpaca:fetchCandles": "tsx --import ../../loadEnv.ts src/broker/alpaca/demo/fetchCandles.ts",
    "alpaca:fetchCandles:op": "op run --env-file=../../.env.op -- npm run alpaca:fetchCandles --",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf coverage dist",
    "dist": "npm run clean && npm run build",
    "fix": "npm run fix:code && npm run fix:other",
    "fix:code": "oxlint . --fix || true",
    "fix:other": "oxfmt",
    "gateway:ibkr": "tsx --import ../../loadEnv.ts src/broker/ibkr/gateway/gateway.ts",
    "gateway:ibkr:op": "op run --env-file=../../.env.op -- npm run gateway:ibkr",
    "gateway:ibkr:paper": "tsx --import ../../loadEnv.ts src/broker/ibkr/gateway/gateway.ts -- --paper",
    "gateway:ibkr:paper:op": "op run --env-file=../../.env.op -- npm run gateway:ibkr:paper",
    "gateway:ibkr:status": "tsx -e \"const {IbkrAPI}=await import('./src/broker/ibkr/api/IbkrAPI.js');console.log(JSON.stringify(await new IbkrAPI().getAuthStatus()))\"",
    "lint": "npm run lint:code && npm run lint:other",
    "lint:code": "oxlint .",
    "lint:other": "oxfmt --list-different",
    "start": "exit 0",
    "test": "npm run test:types && npm run test:units -- --coverage",
    "test:mutation": "stryker run",
    "test:types": "tsc --noEmit",
    "test:units": "vitest run --passWithNoTests",
    "test:units:watch": "vitest --watch",
    "trading212:transactions": "tsx --import ../../loadEnv.ts src/broker/trading212/demo/transactions.ts",
    "trading212:transactions:op": "op run --env-file=../../.env.op -- npm run trading212:transactions"
  },
  "dependencies": {
    "@types/big.js": "^7.0.0",
    "axios": "^1.21.1",
    "axios-retry": "^4.5.0",
    "big.js": "^7.0.1",
    "ms": "4.0.0-nightly.202508271359",
    "ts-retry-promise": "^0.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  },
  "peerDependencies": {
    "playwright": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
