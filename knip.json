{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": ["exports", "nsExports", "nsTypes", "types"],
  "ignoreBinaries": ["nx"],
  "ignoreDependencies": ["conventional-changelog-conventionalcommits", "pino-roll"],
  "workspaces": {
    "packages/exchange": {
      "entry": ["src/**/demo/*.ts"]
    },
    "packages/trading-signals": {
      "entry": ["src/start/**/*.ts"]
    },
    "packages/trading-signals-docs": {
      "entry": ["e2e/**/*.ts"]
    },
    "packages/trading-signals-vocs": {
      "entry": [
        "vocs.config.ts",
        "scripts/stubs/highcharts-react.ts",
        "src/components/BacktestApp.tsx",
        "src/components/IndicatorPageDemo.tsx",
        "src/components/PackageGrid.tsx",
        "src/components/UtilitiesDemo.tsx",
        "src/pages/_root.css",
        "src/shims/*.ts"
      ],
      "ignoreDependencies": ["events"]
    },
    "packages/trading-strategies": {
      "entry": ["src/start/**/*.ts"]
    }
  }
}
