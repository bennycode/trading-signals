# Flags and settings shared by every package. Plain values only, never secrets: secrets go into
# `.env.op` as 1Password references, or into a gitignored `.env` without 1Password. A value in `.env`
# or in the shell environment overrides the one here.

# Trading212 trades the practice account unless this is "false".
TRADING212_USE_PAPER=true

# Where the bot keeps its database and logs.
TYPEDTRADER_DB_DIRECTORY=.database

# Comma-separated Telegram user IDs allowed to use the bot. Empty means anyone can.
TELEGRAM_OWNER_IDS=
